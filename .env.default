DJANGO_SECRET_KEY=replace-this-with-a-long-random-secret
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=smartthingsbridge.mydomain.de,localhost,127.0.0.1

PUBLIC_BASE_URL=https://smartthingsbridge.mydomain.de

MQTT_HOST=192.168.1.10
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=smartthings
MQTT_TLS=0

SMARTTHINGS_API_BASE_URL=https://api.smartthings.com/v1
SMARTTHINGS_CLIENT_ID=
SMARTTHINGS_CLIENT_SECRET=
SMARTTHINGS_REDIRECT_URI=https://smartthingsbridge.mydomain.de/oauth/callback
SMARTTHINGS_WEBHOOK_PATH=/
